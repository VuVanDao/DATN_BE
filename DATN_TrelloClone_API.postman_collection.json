            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập hệ thống (nhận AccessToken và RefreshToken dạng HttpOnly Cookie)."
