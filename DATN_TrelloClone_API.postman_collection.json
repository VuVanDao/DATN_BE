                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  pm.expect(body.success).to.eql(true);",
                "  pm.expect(body.data).to.be.an('array');",
                "  const workspaceIds = body.data.map(g => g.workspaceId);",
                "  pm.expect(new Set(workspaceIds).size).to.eql(workspaceIds.length);",
                "  const projectIds = body.data.flatMap(g => g.projects.map(p => p.id));",
                "  pm.expect(new Set(projectIds).size).to.eql(projectIds.length);",
                "  body.data.forEach(g => {",
                "    pm.expect(g.workspaceName).to.be.a('string');",
                "    pm.expect(g.workspaceSlug).to.be.a('string');",
                "    pm.expect(g.projects).to.be.an('array').that.is.not.empty;",
                "    g.projects.forEach(p => pm.expect(p.workspaceId).to.eql(g.workspaceId));",
