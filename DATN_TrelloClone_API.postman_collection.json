          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    var jwtToken = res.data ? (res.data.token || res.data.accessToken) : null;",
                  "    if (jwtToken) {",
                  "        pm.collectionVariables.set('accessToken', jwtToken);",
                  "        if (pm.environment) { pm.environment.set('accessToken', jwtToken); }",
                  "        console.log('Tự động lưu accessToken sau khi đăng nhập thành công');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
