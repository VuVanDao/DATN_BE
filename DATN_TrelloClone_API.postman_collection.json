  "item": [
    {
      "name": "1. Authentication & Identity",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@datn.vn\",\n  \"username\": \"nguyenvana\",\n  \"password\": \"Password123@\",\n  \"bio\": \"Software Engineer tại ĐATN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Đăng ký tài khoản người dùng mới vào hệ thống."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    var jwtToken = res.data ? (res.data.token || res.data.accessToken) : null;",
                  "    if (jwtToken) {",
                  "        pm.collectionVariables.set('accessToken', jwtToken);",
                  "        if (pm.environment) { pm.environment.set('accessToken', jwtToken); }",
                  "        console.log('Tự động lưu accessToken sau khi đăng ký thành công');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@datn.vn\",\n  \"password\": \"Password123@\"\n}"
