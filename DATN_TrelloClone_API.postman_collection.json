                "auth",
                "refresh-token"
              ]
            },
            "description": "Cấp lại Access Token mới bằng Refresh Token (qua Cookie hoặc Body)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    var jwtToken = res.data ? (res.data.token || res.data.accessToken) : null;",
                  "    if (jwtToken) {",
                  "        pm.collectionVariables.set('accessToken', jwtToken);",
                  "        if (pm.environment) { pm.environment.set('accessToken', jwtToken); }",
                  "        console.log('Tự động cập nhật accessToken mới');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
